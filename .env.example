DATABRICKS_HOST=
DATABRICKS_TOKEN=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_CATALOG=main
DATABRICKS_SCHEMA=spotlight
PORT=3000
# auto: use live SQL only while RUNNING, otherwise labeled demo data (default).
# demo: no warehouse check, SQL or model calls. live: errors instead of fallback.
SPOTLIGHT_DATA_MODE=auto
# Spot Talk uses the existing Databricks host/token and a chat endpoint with CAN QUERY access.
DATABRICKS_CHAT_ENDPOINT=databricks-meta-llama-3-3-70b-instruct
