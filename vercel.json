{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build",
      "devCommand": "node scripts/dev-frontend.mjs",
      "outputDirectory": "dist"
    },
    "api": {
      "root": ".",
      "runtime": "node",
      "entrypoint": "services/api.mjs",
      "buildCommand": "node --check services/api.mjs",
      "devCommand": "node --watch services/api.mjs",
      "functions": {
        "services/api.mjs": {
          "includeFiles": "data/{demo,SPOT_KnightHacks_Challenge_Kit Part One/02_DATA}/**",
          "maxDuration": 120
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "app" } }
  ]
}
